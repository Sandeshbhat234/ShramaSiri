# Copy to .env and fill in. Passed to the app at build time with:
#   flutter run --dart-define-from-file=.env
# Only PUBLIC values go here. Never put the service-role / secret key in the app.

# Supabase project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) or the legacy anon key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
