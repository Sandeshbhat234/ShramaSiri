# Local stack from `npx supabase start` (see docs/SUPABASE_SETUP.md).
# The Android emulator reaches the host computer at 10.0.2.2.
# The key below is printed by `npx supabase status`; local keys are public demo values.
SUPABASE_URL=http://10.0.2.2:55421
SUPABASE_PUBLISHABLE_KEY=paste-local-publishable-key-here
